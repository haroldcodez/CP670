<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <!-- Background color -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <corners android:radius="8dp" />  <!-- Rounded corners -->
                    <stroke android:width="1dp" android:color="@color/design_default_color_primary_dark" />  <!-- Border -->
                </shape>
            </item>
            <!-- Dropdown arrow (right-aligned) -->
            <item android:gravity="end|center_vertical" android:right="8dp">
                <bitmap android:src="@drawable/arrow_btn_down"
                android:tint="@color/black" />
            </item>
        </layer-list>
    </item>
</selector>